{
  "functions": {
    "api/arkaios.js": {
      "maxDuration": 30
    },
    "api/arkaios-tools.js": {
      "maxDuration": 30
    },
    "api/arkaios-image.js": {
      "maxDuration": 60
    },
    "api/arkaios-orquestador.js": {
      "maxDuration": 60
    },
    "api/banco-frutas.js": {
      "maxDuration": 30
    },
    "api/publish-template.js": {
      "maxDuration": 60
    },
    "api/apikey.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/login",
      "destination": "/login.html"
    },
    {
      "source": "/api/apikey",
      "destination": "/api/apikey.js"
    },
    {
      "source": "/api/pos-login",
      "destination": "/api/pos?__op=pos-login"
    },
    {
      "source": "/api/client-login",
      "destination": "/api/pos?__op=client-login"
    },
    {
      "source": "/api/pos-accounts",
      "destination": "/api/pos?__op=pos-accounts"
    },
    {
      "source": "/api/bridge",
      "destination": "/api/bridges?__op=bridge"
    },
    {
      "source": "/api/elemia-bridge",
      "destination": "/api/bridges?__op=elemia-bridge"
    }
  ]
}
