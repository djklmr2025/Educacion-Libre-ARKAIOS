{
  "functions": {
    "api/arkaios.js": {
      "maxDuration": 30
    },
    "api/arkaios-tools.js": {
      "maxDuration": 30
    },
    "api/arkaios-image.js": {
      "maxDuration": 60
    },
    "api/arkaios-orquestador.js": {
      "maxDuration": 60
    },
    "api/banco-frutas.js": {
      "maxDuration": 30
    },
    "api/publish-template.js": {
      "maxDuration": 60
    },
    "api/apikey.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api/freepik",
      "destination": "/api/pexels"
    },
    {
      "source": "/api/picsum",
      "destination": "/api/pexels"
    },
    {
      "source": "/api/pixabay",
      "destination": "/api/pexels"
    },
    {
      "source": "/login",
      "destination": "/login.html"
    },
    {
      "source": "/api/apikey",
      "destination": "/api/apikey.js"
    },
    {
      "source": "/api/pos-login",
      "destination": "/api/pos?__op=pos-login"
    },
    {
      "source": "/api/client-login",
      "destination": "/api/pos?__op=client-login"
    },
    {
      "source": "/api/pos-accounts",
      "destination": "/api/pos?__op=pos-accounts"
    },
    {
      "source": "/api/bridge",
      "destination": "/api/bridges?__op=bridge"
    },
    {
      "source": "/api/elemia-bridge",
      "destination": "/api/bridges?__op=elemia-bridge"
    },
    {
      "source": "/api/arkaios-feed",
      "destination": "/api/bridges?__op=arkaios-feed"
    },
    {
      "source": "/forum",
      "destination": "/forum.html"
    },
    {
      "source": "/comunidad",
      "destination": "/comunidad.html"
    },
    {
      "source": "/api/comunidad",
      "destination": "/api/bridges?__op=comunidad"
    },
    {
      "source": "/api/task-inbox",
      "destination": "/api/bridges?__op=task-inbox"
    },
    {
      "source": "/api/v1/:path*",
      "destination": "/api/bridges?__op=forum"
    }
  ]
}
